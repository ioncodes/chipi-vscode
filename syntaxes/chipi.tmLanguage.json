{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "Chipi",
  "scopeName": "source.chipi",
  "patterns": [
    {
      "include": "#comments"
    },
    {
      "include": "#include-statement"
    },
    {
      "include": "#bindings-target-block"
    },
    {
      "include": "#bindings-dispatch-block"
    },
    {
      "include": "#bindings-processor-block"
    },
    {
      "include": "#bindings-architecture-block"
    },
    {
      "include": "#bindings-handler-block"
    },
    {
      "include": "#bindings-keywords"
    },
    {
      "include": "#decoder-block"
    },
    {
      "include": "#subdecoder-block"
    },
    {
      "include": "#type-definition"
    },
    {
      "include": "#map-block"
    },
    {
      "include": "#fragment-line"
    },
    {
      "include": "#format-line"
    },
    {
      "include": "#instruction-definition"
    }
  ],
  "repository": {
    "comments": {
      "name": "comment.line.number-sign.chipi",
      "match": "#.*$"
    },
    "include-statement": {
      "name": "meta.include.chipi",
      "match": "^\\s*(include)\\s+(\"[^\"]*\")\\s*$",
      "captures": {
        "1": {
          "name": "keyword.control.include.chipi"
        },
        "2": {
          "name": "string.quoted.double.include.chipi"
        }
      }
    },
    "decoder-block": {
      "name": "meta.decoder.chipi",
      "begin": "^\\s*(decoder)\\s+([A-Z][a-zA-Z0-9_]*)\\s*(\\{)",
      "end": "\\}",
      "beginCaptures": {
        "1": {
          "name": "keyword.control.decoder.chipi"
        },
        "2": {
          "name": "entity.name.type.decoder.chipi"
        },
        "3": {
          "name": "punctuation.section.block.begin.chipi"
        }
      },
      "endCaptures": {
        "0": {
          "name": "punctuation.section.block.end.chipi"
        }
      },
      "patterns": [
        {
          "include": "#comments"
        },
        {
          "include": "#decoder-properties"
        }
      ]
    },
    "subdecoder-block": {
      "name": "meta.subdecoder.chipi",
      "begin": "^\\s*(subdecoder)\\s+([A-Z][a-zA-Z0-9_]*)\\s*(\\{)",
      "end": "\\}",
      "beginCaptures": {
        "1": {
          "name": "keyword.control.subdecoder.chipi"
        },
        "2": {
          "name": "entity.name.type.subdecoder.chipi"
        },
        "3": {
          "name": "punctuation.section.block.begin.chipi"
        }
      },
      "endCaptures": {
        "0": {
          "name": "punctuation.section.block.end.chipi"
        }
      },
      "patterns": [
        {
          "include": "#comments"
        },
        {
          "include": "#decoder-properties"
        }
      ]
    },
    "decoder-properties": {
      "patterns": [
        {
          "name": "meta.property.width.chipi",
          "match": "^\\s*(width)\\s*(=)\\s*(\\d+)\\s*$",
          "captures": {
            "1": {
              "name": "variable.parameter.chipi"
            },
            "2": {
              "name": "keyword.operator.assignment.chipi"
            },
            "3": {
              "name": "constant.numeric.decimal.chipi"
            }
          }
        },
        {
          "name": "meta.property.bit-order.chipi",
          "match": "^\\s*(bit_order)\\s*(=)\\s*(msb0|lsb0)\\s*$",
          "captures": {
            "1": {
              "name": "variable.parameter.chipi"
            },
            "2": {
              "name": "keyword.operator.assignment.chipi"
            },
            "3": {
              "name": "constant.language.chipi"
            }
          }
        },
        {
          "name": "meta.property.endian.chipi",
          "match": "^\\s*(endian)\\s*(=)\\s*(big|little)\\s*$",
          "captures": {
            "1": {
              "name": "variable.parameter.chipi"
            },
            "2": {
              "name": "keyword.operator.assignment.chipi"
            },
            "3": {
              "name": "constant.language.chipi"
            }
          }
        },
        {
          "name": "meta.property.max-units.chipi",
          "match": "^\\s*(max_units)\\s*(=)\\s*(\\d+)\\s*$",
          "captures": {
            "1": {
              "name": "variable.parameter.chipi"
            },
            "2": {
              "name": "keyword.operator.assignment.chipi"
            },
            "3": {
              "name": "constant.numeric.decimal.chipi"
            }
          }
        }
      ]
    },
    "type-definition": {
      "name": "meta.type.chipi",
      "match": "^\\s*(type)\\s+([a-z][a-zA-Z0-9_]*)\\s*(=)\\s+(.*)$",
      "captures": {
        "1": {
          "name": "keyword.control.type.chipi"
        },
        "2": {
          "name": "entity.name.type.chipi"
        },
        "3": {
          "name": "keyword.operator.assignment.chipi"
        },
        "4": {
          "patterns": [
            {
              "include": "#type-expression"
            }
          ]
        }
      }
    },
    "type-expression": {
      "patterns": [
        {
          "name": "meta.type.primitive.chipi",
          "match": "([a-z0-9_]+)(?:\\s*(\\{)([^}]*)(\\}))?",
          "captures": {
            "1": {
              "name": "storage.type.primitive.chipi"
            },
            "2": {
              "name": "punctuation.section.block.begin.chipi"
            },
            "3": {
              "patterns": [
                {
                  "include": "#transforms"
                }
              ]
            },
            "4": {
              "name": "punctuation.section.block.end.chipi"
            }
          }
        }
      ]
    },
    "transforms": {
      "patterns": [
        {
          "name": "meta.transform.chipi",
          "match": "(sign_extend|zero_extend|shift_left)\\((\\d+)\\)",
          "captures": {
            "1": {
              "name": "support.function.transform.chipi"
            },
            "2": {
              "name": "constant.numeric.decimal.chipi"
            }
          }
        },
        {
          "name": "meta.transform.display.chipi",
          "match": "(display)\\(([a-z_]+)\\)",
          "captures": {
            "1": {
              "name": "support.function.transform.chipi"
            },
            "2": {
              "name": "constant.language.chipi"
            }
          }
        },
        {
          "name": "punctuation.separator.comma.chipi",
          "match": ","
        }
      ]
    },
    "map-block": {
      "name": "meta.map.chipi",
      "begin": "^\\s*(map)\\s+([a-z_][a-zA-Z0-9_]*)\\s*\\(([^)]*)\\)\\s*(\\{)",
      "end": "\\}",
      "beginCaptures": {
        "1": {
          "name": "keyword.control.map.chipi"
        },
        "2": {
          "name": "entity.name.function.map.chipi"
        },
        "3": {
          "patterns": [
            {
              "name": "variable.parameter.map.chipi",
              "match": "[a-z_][a-zA-Z0-9_]*"
            },
            {
              "name": "punctuation.separator.comma.chipi",
              "match": ","
            }
          ]
        },
        "4": {
          "name": "punctuation.section.block.begin.chipi"
        }
      },
      "endCaptures": {
        "0": {
          "name": "punctuation.section.block.end.chipi"
        }
      },
      "patterns": [
        {
          "include": "#comments"
        },
        {
          "include": "#map-entry"
        }
      ]
    },
    "map-entry": {
      "name": "meta.map-entry.chipi",
      "match": "^\\s*([^=>#]+?)(=>)\\s*(.*)$",
      "captures": {
        "1": {
          "patterns": [
            {
              "name": "constant.numeric.decimal.chipi",
              "match": "\\b\\d+\\b"
            },
            {
              "name": "constant.numeric.hex.chipi",
              "match": "\\b0[xX][0-9a-fA-F]+\\b"
            },
            {
              "name": "constant.language.wildcard.chipi",
              "match": "\\b_\\b"
            },
            {
              "name": "punctuation.separator.comma.chipi",
              "match": ","
            }
          ]
        },
        "2": {
          "name": "keyword.operator.arrow.chipi"
        },
        "3": {
          "patterns": [
            {
              "include": "#format-interpolation"
            },
            {
              "name": "string.unquoted.map-output.chipi",
              "match": "[^{]+"
            }
          ]
        }
      }
    },
    "fragment-line": {
      "name": "meta.fragment-line.chipi",
      "match": "^\\s*(\\|)\\s*(\\.([a-z_][a-zA-Z0-9_]*))\\s*(=)\\s*\"([^\"]*)\"\\s*$",
      "captures": {
        "1": {
          "name": "keyword.operator.pipe.chipi"
        },
        "2": {
          "name": "variable.parameter.fragment.chipi"
        },
        "3": {
          "name": "entity.name.tag.fragment.chipi"
        },
        "4": {
          "name": "keyword.operator.assignment.chipi"
        },
        "5": {
          "name": "string.quoted.double.format.chipi",
          "patterns": [
            {
              "include": "#format-interpolation"
            }
          ]
        }
      }
    },
    "format-line": {
      "name": "meta.format-line.chipi",
      "match": "^\\s*(\\|)\\s*(?:([^\"]*?)(:)\\s*)?\"([^\"]*)\"\\s*$",
      "captures": {
        "1": {
          "name": "keyword.operator.pipe.chipi"
        },
        "2": {
          "patterns": [
            {
              "include": "#guard-expression"
            }
          ]
        },
        "3": {
          "name": "punctuation.separator.guard.chipi"
        },
        "4": {
          "name": "string.quoted.double.format.chipi",
          "patterns": [
            {
              "include": "#format-interpolation"
            }
          ]
        }
      }
    },
    "guard-expression": {
      "patterns": [
        {
          "name": "keyword.operator.comparison.chipi",
          "match": "==|!=|<=|>=|<|>"
        },
        {
          "name": "keyword.operator.logical.chipi",
          "match": "&&"
        },
        {
          "name": "constant.numeric.decimal.chipi",
          "match": "\\b\\d+\\b"
        },
        {
          "name": "constant.numeric.hex.chipi",
          "match": "\\b0[xX][0-9a-fA-F]+\\b"
        },
        {
          "name": "variable.parameter.field.chipi",
          "match": "\\b[a-z_][a-zA-Z0-9_]*\\b"
        },
        {
          "name": "punctuation.separator.comma.chipi",
          "match": ","
        }
      ]
    },
    "format-interpolation": {
      "name": "meta.interpolation.chipi",
      "begin": "\\{",
      "end": "\\}",
      "beginCaptures": {
        "0": {
          "name": "punctuation.section.interpolation.begin.chipi"
        }
      },
      "endCaptures": {
        "0": {
          "name": "punctuation.section.interpolation.end.chipi"
        }
      },
      "patterns": [
        {
          "name": "keyword.operator.ternary.chipi",
          "match": "\\?"
        },
        {
          "name": "keyword.operator.arithmetic.chipi",
          "match": "[+\\-*]"
        },
        {
          "name": "punctuation.separator.format-spec.chipi",
          "match": ":"
        },
        {
          "name": "constant.other.format-spec.chipi",
          "match": "(?<=:)[#0-9a-zA-Z]+"
        },
        {
          "name": "support.function.builtin.chipi",
          "match": "\\b(rotate_right|rotate_left)\\b"
        },
        {
          "name": "entity.name.function.map-call.chipi",
          "match": "\\b([a-z_][a-zA-Z0-9_]*)(?=\\()"
        },
        {
          "name": "constant.numeric.decimal.chipi",
          "match": "\\b\\d+\\b"
        },
        {
          "name": "constant.numeric.hex.chipi",
          "match": "\\b0[xX][0-9a-fA-F]+\\b"
        },
        {
          "comment": "Dotted field access for sub-decoder fragments (e.g. ext.mnemonic)",
          "name": "variable.parameter.field.chipi",
          "match": "\\b[a-z_][a-zA-Z0-9_]*\\.[a-z_][a-zA-Z0-9_]*\\b"
        },
        {
          "name": "variable.parameter.field.chipi",
          "match": "\\b[a-z_][a-zA-Z0-9_]*\\b"
        }
      ]
    },
    "instruction-definition": {
      "name": "meta.instruction.chipi",
      "match": "^\\s*([a-z_][a-z0-9_]*)\\s+(.*)$",
      "captures": {
        "1": {
          "name": "entity.name.function.instruction.chipi"
        },
        "2": {
          "patterns": [
            {
              "include": "#instruction-parts"
            }
          ]
        }
      }
    },
    "instruction-parts": {
      "patterns": [
        {
          "include": "#fixed-bits"
        },
        {
          "include": "#named-field"
        }
      ]
    },
    "fixed-bits": {
      "name": "meta.fixed-bits.chipi",
      "match": "\\[(\\d+)(?::(\\d+))?\\]\\s*=\\s*([01?]+)",
      "captures": {
        "1": {
          "name": "constant.numeric.decimal.chipi"
        },
        "2": {
          "name": "constant.numeric.decimal.chipi"
        },
        "3": {
          "patterns": [
            {
              "name": "constant.character.wildcard.chipi",
              "match": "\\?+"
            },
            {
              "name": "constant.numeric.binary.chipi",
              "match": "[01]+"
            }
          ]
        }
      }
    },
    "named-field": {
      "name": "meta.field.chipi",
      "match": "([a-z_][a-z0-9_]*)\\s*:\\s*([a-zA-Z_][a-zA-Z0-9_]*)(?:\\s*(\\{)([^}]*)(\\}))?\\s*\\[(\\d+)(?::(\\d+))?\\]",
      "captures": {
        "1": {
          "name": "variable.parameter.field.chipi"
        },
        "2": {
          "name": "storage.type.chipi"
        },
        "3": {
          "name": "punctuation.section.block.begin.chipi"
        },
        "4": {
          "patterns": [
            {
              "include": "#transforms"
            }
          ]
        },
        "5": {
          "name": "punctuation.section.block.end.chipi"
        },
        "6": {
          "name": "constant.numeric.decimal.chipi"
        },
        "7": {
          "name": "constant.numeric.decimal.chipi"
        }
      }
    },
    "bindings-target-block": {
      "name": "meta.bindings.target.chipi",
      "begin": "^\\s*(target)\\s+(rust|cpp|ida|binja)\\s*(\\{)",
      "end": "^\\}",
      "beginCaptures": {
        "1": { "name": "keyword.other.bindings.chipi" },
        "2": { "name": "constant.language.target.chipi" },
        "3": { "name": "punctuation.section.block.begin.chipi" }
      },
      "endCaptures": {
        "0": { "name": "punctuation.section.block.end.chipi" }
      },
      "patterns": [
        { "include": "#comments" },
        { "include": "#bindings-decoder-block" },
        { "include": "#bindings-dispatch-block" },
        { "include": "#bindings-processor-block" },
        { "include": "#bindings-architecture-block" }
      ]
    },
    "bindings-decoder-block": {
      "name": "meta.bindings.decoder.chipi",
      "begin": "^(\\s*)(decoder|subdecoder)\\s+([A-Z][a-zA-Z0-9_]*)\\s*(\\{)",
      "end": "^\\1\\}",
      "beginCaptures": {
        "2": { "name": "keyword.other.bindings.chipi" },
        "3": { "name": "entity.name.type.decoder.chipi" },
        "4": { "name": "punctuation.section.block.begin.chipi" }
      },
      "endCaptures": {
        "0": { "name": "punctuation.section.block.end.chipi" }
      },
      "patterns": [
        { "include": "#comments" },
        { "include": "#bindings-decoder-block" },
        { "include": "#bindings-includes-block" },
        { "include": "#bindings-type-alias" },
        { "include": "#bindings-keyword-with-string" },
        { "include": "#bindings-keyword-with-ident" },
        { "include": "#bindings-strings" },
        { "include": "#bindings-path" },
        { "include": "#bindings-numbers" }
      ]
    },
    "bindings-dispatch-block": {
      "name": "meta.bindings.dispatch.chipi",
      "begin": "^(\\s*)(dispatch|subdispatch)\\s+([A-Z][a-zA-Z0-9_]*)\\s*(\\{)",
      "end": "^\\1\\}",
      "beginCaptures": {
        "2": { "name": "keyword.other.bindings.chipi" },
        "3": { "name": "entity.name.type.dispatch.chipi" },
        "4": { "name": "punctuation.section.block.begin.chipi" }
      },
      "endCaptures": {
        "0": { "name": "punctuation.section.block.end.chipi" }
      },
      "patterns": [
        { "include": "#comments" },
        { "include": "#bindings-handler-block" },
        { "include": "#bindings-instruction-type-block" },
        { "include": "#bindings-dispatch-block" },
        { "include": "#bindings-keyword-with-string" },
        { "include": "#bindings-keyword-with-strategy" },
        { "include": "#bindings-keyword-with-path" },
        { "include": "#bindings-strings" },
        { "include": "#bindings-strategy" },
        { "include": "#bindings-path" }
      ]
    },
    "bindings-processor-block": {
      "name": "meta.bindings.processor.chipi",
      "begin": "^(\\s*)(processor)\\s+([A-Z][a-zA-Z0-9_]*)\\s*(\\{)",
      "end": "^\\1\\}",
      "beginCaptures": {
        "2": { "name": "keyword.other.bindings.chipi" },
        "3": { "name": "entity.name.type.processor.chipi" },
        "4": { "name": "punctuation.section.block.begin.chipi" }
      },
      "endCaptures": {
        "0": { "name": "punctuation.section.block.end.chipi" }
      },
      "patterns": [
        { "include": "#comments" },
        { "include": "#bindings-registers-block" },
        { "include": "#bindings-flow-block" },
        { "include": "#bindings-keyword-with-string" },
        { "include": "#bindings-keyword-with-number" },
        { "include": "#bindings-strings" },
        { "include": "#bindings-numbers" }
      ]
    },
    "bindings-architecture-block": {
      "name": "meta.bindings.architecture.chipi",
      "begin": "^(\\s*)(architecture)\\s+([A-Z][a-zA-Z0-9_]*)\\s*(\\{)",
      "end": "^\\1\\}",
      "beginCaptures": {
        "2": { "name": "keyword.other.bindings.chipi" },
        "3": { "name": "entity.name.type.architecture.chipi" },
        "4": { "name": "punctuation.section.block.begin.chipi" }
      },
      "endCaptures": {
        "0": { "name": "punctuation.section.block.end.chipi" }
      },
      "patterns": [
        { "include": "#comments" },
        { "include": "#bindings-registers-block" },
        { "include": "#bindings-keyword-with-string" },
        { "include": "#bindings-keyword-with-number" },
        { "include": "#bindings-keyword-with-endianness" },
        { "include": "#bindings-strings" },
        { "include": "#bindings-numbers" },
        { "include": "#bindings-endianness" }
      ]
    },
    "bindings-handler-block": {
      "name": "meta.bindings.handler.chipi",
      "begin": "^(\\s*)(handler)\\s+([a-z_][a-zA-Z0-9_]*)(?:\\s*<([^>]*)>)?\\s*(\\{)",
      "end": "^\\1\\}",
      "beginCaptures": {
        "2": { "name": "keyword.other.bindings.chipi" },
        "3": { "name": "entity.name.function.handler.chipi" },
        "4": {
          "patterns": [
            { "name": "storage.modifier.const.chipi", "match": "\\bconst\\b" },
            { "name": "variable.parameter.handler.chipi", "match": "\\b[a-zA-Z_][a-zA-Z0-9_]*\\b" }
          ]
        },
        "5": { "name": "punctuation.section.block.begin.chipi" }
      },
      "endCaptures": {
        "0": { "name": "punctuation.section.block.end.chipi" }
      },
      "patterns": [
        { "include": "#comments" },
        {
          "name": "entity.name.function.instruction.chipi",
          "match": "\\b[a-z_][a-zA-Z0-9_]*\\b"
        }
      ]
    },
    "bindings-instruction-type-block": {
      "name": "meta.bindings.instruction-type.chipi",
      "begin": "^(\\s*)(instruction_type)\\s+([a-zA-Z_][a-zA-Z0-9_:]*)\\s*(\\{)",
      "end": "^\\1\\}",
      "beginCaptures": {
        "2": { "name": "keyword.other.bindings.chipi" },
        "3": { "name": "entity.name.type.path.chipi" },
        "4": { "name": "punctuation.section.block.begin.chipi" }
      },
      "endCaptures": {
        "0": { "name": "punctuation.section.block.end.chipi" }
      },
      "patterns": [
        { "include": "#comments" },
        { "include": "#bindings-keyword-with-string" },
        { "include": "#bindings-strings" }
      ]
    },
    "bindings-registers-block": {
      "name": "meta.bindings.registers.chipi",
      "begin": "^(\\s*)(registers|segment_registers)\\s*(\\{)",
      "end": "^\\1\\}",
      "beginCaptures": {
        "2": { "name": "keyword.other.bindings.chipi" },
        "3": { "name": "punctuation.section.block.begin.chipi" }
      },
      "endCaptures": {
        "0": { "name": "punctuation.section.block.end.chipi" }
      },
      "patterns": [
        { "include": "#comments" },
        {
          "name": "variable.other.register.chipi",
          "match": "\\b[a-zA-Z_][a-zA-Z0-9_]*\\b"
        }
      ]
    },
    "bindings-flow-block": {
      "name": "meta.bindings.flow.chipi",
      "begin": "^(\\s*)(flow)\\s*(\\{)",
      "end": "^\\1\\}",
      "beginCaptures": {
        "2": { "name": "keyword.other.bindings.chipi" },
        "3": { "name": "punctuation.section.block.begin.chipi" }
      },
      "endCaptures": {
        "0": { "name": "punctuation.section.block.end.chipi" }
      },
      "patterns": [
        { "include": "#comments" },
        { "include": "#bindings-flow-inner-block" }
      ]
    },
    "bindings-flow-inner-block": {
      "name": "meta.bindings.flow.inner.chipi",
      "begin": "^(\\s*)(calls|returns|stops)\\s*(\\{)",
      "end": "^\\1\\}",
      "beginCaptures": {
        "2": { "name": "keyword.other.bindings.chipi" },
